+    public function getFullInfo(mixed $id): array
+    {
+        $partial = $this->getInfo($id);
+        if (DialogId::isSecretChat($partial['bot_api_id'])) {
+            return $partial;
+        }
+        $full = $this->peerDatabase->getFull($partial['bot_api_id']);
+        $cacheTime = $this->getSettings()->getPeer()->getFullInfoCacheTime();
+        if ($cacheTime > 0 && time() - ($full['inserted'] ?? 0) < $cacheTime) {
+            return array_merge($partial, $full);
+        }
+        $freshReply = null;
+        switch ($partial['type']) {
+            case 'user':
+            case 'bot':
+                $this->methodCallAsyncRead('users.getFullUser', ['id' => $partial['bot_api_id']]);
+                break;
+            case 'chat':
+                $freshReply = $this->methodCallAsyncRead('messages.getFullChat', $partial);
+                break;
+            case 'channel':
+            case 'supergroup':
+                $freshReply = $this->methodCallAsyncRead('channels.getFullChannel', ['channel' => $partial['bot_api_id']]);
+                break;
+        }
+        $result = array_merge($partial, $this->peerDatabase->getFull($partial['bot_api_id']));
+        // Shabbat local compatibility patch: never persist this per-call RPC evidence.
+        // Keep the public helper signature and ordinary cache semantics unchanged.
+        if ($cacheTime === 0 && $freshReply !== null) {
+            $result['_shabbat_fresh_full_peer_v1'] = $freshReply;
+        }
+        return $result;
+    }
